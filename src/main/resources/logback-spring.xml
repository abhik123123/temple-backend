<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs go to stdout only (12-factor): Docker, CloudWatch or any log shipper
  collects them from there. Levels are set in application*.yml.
  Never enable org.hibernate.orm.jdbc.bind TRACE in production: it logs query
  parameters, including password hashes and devotees' personal data.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
