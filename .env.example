# Copy to .env (git-ignored) for docker compose, or set these in your hosting platform.

# --- Database (PostgreSQL) ---
POSTGRES_DB=templedb
DB_USERNAME=temple
DB_PASSWORD=change-me-db

# --- Security ---
# Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_TTL=8h
# First administrator, created only when the admins table is empty (password >= 12 chars).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Temple Admin

# --- Optional: email (newsletter confirmation, test email, weekly digest) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
NEWSLETTER_FROM=no-reply@rajarajeshwara.org
NEWSLETTER_ENABLED=false
# Public URL of the website (used in email links)
SITE_URL=https://www.rajarajeshwara.org

# Only if the UI is hosted on a different origin than /api (comma-separated)
APP_CORS_ALLOWED_ORIGINS=
